# ==============================================================================
# Instigate Cafe Bot — Git Ignore Rules
# Note: .gitignore prevents tracking new files; it cannot untrack files already
# committed in Git history. Use `git rm --cached <path>` and tools/scan_secrets.py.
# ==============================================================================

# Secrets, Environment Files & Key Material
.env
.env.*
.envrc
!.env.example
*.pem
*.key
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*client_secret*.json
*credentials*.json

# SQLite Databases, WAL/SHM Journals & Backups
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm
*.db.bak
*.db.bak.*
ic_stock.db
tmu_grades.db
ic_stock-dev.db

# Private Community Lore (only synthetic templates may be tracked)
tools/lore.json
tools/lore.*.json
lore.json
lore.*.json
!tools/lore.example.json
!tests/fixtures/synthetic_lore.json

# Logs, Reports, Benchmarks & Working Screenshot Captures
*.log
artifacts/
benchmark_results*.json
status_issue_report*.md
distribution.png
tmu_raw.html
scratch/
assets/temp/
assets/screenshots/raw/
assets/screenshots/work/
assets/screenshots/*.raw.png
assets/screenshots/*.unredacted.*

# Virtual Environments
.venv/
venv/
env/
ENV/
.pdm-python
.pdm-build/
.pixi/

# Python Bytecode, Test, Lint, Type & Coverage Caches
__pycache__/
*.py[codz]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.hypothesis/
.cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
nosetests.xml
*.cover
*.py.cover

# Packaging & Build Artifacts
build/
dist/
*.egg-info/
.eggs/
wheels/
MANIFEST

# IDE & OS State
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
