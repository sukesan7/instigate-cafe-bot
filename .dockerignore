# ==============================================================================
# Docker / Container Ignore Rules for Instigate Cafe Bot
# Guarantees only required runtime files enter the Docker build context and no
# credentials, SQLite DBs, private lore, tests, docs, or scratch captures leak.
# ==============================================================================

# Secrets, Environment Files & Key Material
.env
.env.*
.envrc
!.env.example
*.pem
*.key
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*client_secret*.json
*credentials*.json

# SQLite Databases, WAL/SHM Journals & Backups
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm
*.db.bak
*.db.bak.*
ic_stock.db
tmu_grades.db
ic_stock-dev.db

# Private Community Lore
tools/lore.json
tools/lore.*.json
lore.json
lore.*.json
!tools/lore.example.json

# Non-Runtime Repo Directories & Working Captures
.git/
.github/
docs/
tests/
scripts/
scratch/
artifacts/
assets/temp/
assets/screenshots/
benchmark_results*.json
status_issue_report*.md
distribution.png
tmu_raw.html
*.log
Makefile
.pre-commit-config.yaml

# Virtual Environments, Caches & IDE State
.venv/
venv/
env/
__pycache__/
*.py[codz]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.vscode/
.idea/
.DS_Store
