# ==============================================================================
# Instigate Cafe Bot — Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' (do NOT commit your real '.env' file to Git).
# 2. Fill in your Discord bot credentials and desired channel/guild IDs.
# 3. All optional integrations (LLM, Market Watch, Transit, Jobs) default to
#    disabled ('false') below so that the bot boots cleanly in local development.
# ==============================================================================

# ==============================================================================
# Discord — Core Configuration
# ==============================================================================
# Discord Application Bot Token (from https://discord.com/developers/applications)
DISCORD_TOKEN=

# Guild (Server) Snowflake ID for instant application command synchronization.
# Set to 0 or leave blank to register global slash commands (takes up to 1 hour to propagate).
# Example: GUILD_ID=123456789012345678
GUILD_ID=0

# ==============================================================================
# Discord — Roles & Permissions
# ==============================================================================
# Comma-separated list of role IDs authorized for administrative bot commands.
# Example: ALLOWED_ROLE_IDS=123456789012345678,234567890123456789
ALLOWED_ROLE_IDS=

# Channel ID where standard user-facing commands are permitted.
# Example: USER_COMMAND_CHANNEL_ID=123456789012345678
USER_COMMAND_CHANNEL_ID=0

# Force slash command re-sync with Discord on bot startup (useful for debugging).
FORCE_GUILD_RESYNC=false

# Runtime gateway safeguard: must be explicitly set to 'true' (or pass --allow-gateway)
# before launching the live Discord gateway. Defaults to 'false' for local dev and CI.
# Railway production deployments must explicitly set ICBOT_ALLOW_GATEWAY=true.
ICBOT_ALLOW_GATEWAY=false

# Background task supervision bounds (jitter spread on startup and max error backoff)
TASK_STARTUP_JITTER_SECONDS=15
TASK_MAX_BACKOFF_SECONDS=1800

# ==============================================================================
# Embed Display Settings
# ==============================================================================
# Public URL for the bot avatar or community logo in embed headers.
EMBED_LOGO_URL=

# Accent color for Discord embed borders (hex string e.g. '#A64DFF' or '0xA64DFF')
EMBED_ACCENT_COLOR=#A64DFF

# Footer text displayed on standard embeds
EMBED_FOOTER_TEXT=Instigate Cafe

# ==============================================================================
# LLM Mention Assistant & AI Resume Review (Google Gemini)
# ==============================================================================
# Global master switch for ALL Gemini AI calls (@mention assistant and /ic resume).
# Defaults to 'false' (deny-first). Setting GEMINI_API_KEY alone NEVER enables AI calls.
LLM_ENABLED=false

# Google Gemini API key (from https://aistudio.google.com/; unused while LLM_ENABLED=false)
GEMINI_API_KEY=

# Default models for general chat assistant and resume review
GEMINI_MODEL=gemini-2.5-flash
GEMINI_RESUME_MODEL=gemini-2.5-pro

# System prompts for resume analysis (optional customizations)
GEMINI_RESUME_PROMPT=
GEMINI_RESUME_PROMPT_HW=
GEMINI_RESUME_PROMPT_ELE=

# Privacy and context bounds for mention responses
LLM_CHANNEL_HISTORY_ENABLED=false
LLM_LORE_ENABLED=false
LLM_IMAGES_ENABLED=true
LLM_ALLOW_DM=false
LLM_ALLOWED_CHANNEL_IDS=
LLM_ALLOWED_ROLE_IDS=
LLM_COOLDOWN_SECONDS=3
LLM_MAX_MESSAGES=25
LLM_MAX_CHARS=12000
LLM_MAX_IMAGE_BYTES=2000000
LLM_MAX_OUTPUT_TOKENS=1536
LLM_DEBUG=false

# Custom lore pack file path (optional, defaults to tools/lore.json, tools/lore.example.json)
LORE_PATH=

# ==============================================================================
# Stock Market & Economy Features
# ==============================================================================
# Primary channel for market quotes and portfolio updates
STOCK_CHANNEL_ID=0

# Daily economy faucet claim amount (used by /ic daily)
DAILY_CLAIM_AMOUNT=100

# Automated market volatility watcher (VIX spikes and large percentage moves)
MARKET_WATCH_ENABLED=false
MARKET_WATCH_CHANNEL_ID=0
MARKET_WATCH_POLL_SECONDS=60
MARKET_WATCH_VIX_LEVEL=20.0
MARKET_WATCH_INDEX_MOVE_PCT=2.5
MARKET_WATCH_STOCK_MOVE_PCT=10.0
MARKET_WATCH_COOLDOWN_MINUTES=30
# Comma-separated list of custom tickers to monitor (leave empty for default index basket)
# Example: MARKET_WATCH_TICKERS=SPY,QQQ,AAPL,NVDA
MARKET_WATCH_TICKERS=
MARKET_WATCH_DEBUG=false

# Scheduled daily market closing recap
MARKET_DAILY_REPORT_ENABLED=false
MARKET_DAILY_REPORT_CHANNEL_ID=0
MARKET_DAILY_REPORT_TIME=16:30
MARKET_DAILY_REPORT_TZ=America/Toronto
MARKET_DAILY_REPORT_TOP_N=8
# Comma-separated list of tickers for the daily report
MARKET_DAILY_REPORT_TICKERS=
MARKET_DAILY_REPORT_DEBUG=false

# Bitcoin on-chain address watcher (treasury/whale transactions via Esplora)
BTC_WATCH_ENABLED=false
BTC_WATCH_CHANNEL_ID=0
BTC_WATCH_POLL_SECONDS=300
BTC_WATCH_COOLDOWN_MINUTES=30
BTC_WATCH_LABEL=BTC Watch
# Comma-separated list of Bitcoin addresses to monitor (max 50 recommended)
BTC_WATCH_ADDRESSES=
# Esplora API endpoint (leave blank to use default public Blockstream endpoint)
BTC_ESPLORA_BASE_URL=https://blockstream.info/api
BTC_WATCH_DEBUG=false

# [LEGACY / DEPRECATED] Alpha Vantage API Key
# Market quotes use Yahoo Finance; setting ALPHAVANTAGE_API_KEY emits a DeprecationWarning.
ALPHAVANTAGE_API_KEY=

# ==============================================================================
# Sports / Odds API & RSS Feeds
# ==============================================================================
# API key from https://the-odds-api.com/ (optional; RSS headlines remain active without it)
ODDS_API_KEY=
# Optional comma-separated custom RSS feed URL overrides per sport
SPORTS_RSS_NBA=
SPORTS_RSS_NFL=
SPORTS_RSS_MMA=
SPORTS_RSS_UFC=
SPORTS_RSS_BOXING=

# ==============================================================================
# Transit Alerts — TTC (Toronto Transit Commission via Mastodon)
# ==============================================================================
# [DEPRECATED] Legacy fallback for TTC_ALERTS_CHANNEL_ID
TTC_CHANNEL_ID=0
# Output channel for TTC transit notifications
TTC_ALERTS_CHANNEL_ID=0
TTC_POLL_SECONDS=120
TTC_ALERT_LEVEL=major
TTC_BOOTSTRAP_POST_LATEST=false
TTC_MASTODON_BASE=
TTC_MASTODON_ACCT=
TTC_INCLUDE_REPLIES=true
TTC_INCLUDE_REBLOGS=false
TTC_DEBUG=false

# ==============================================================================
# Transit Alerts — GO Transit (Official Metrolinx Open Data API)
# ==============================================================================
# Base URL: https://api.openmetrolinx.com/OpenDataAPI/api/V1
GO_API_BASE=https://api.openmetrolinx.com/OpenDataAPI/api/V1
# Metrolinx OpenData API key (from https://www.metrolinx.com/en/about-us/open-data)
GO_API_KEY=
GO_ALERTS_CHANNEL_ID=0
GO_POLL_SECONDS=180
GO_ALERT_LEVEL=major
# Code default is true; set false in local dev templates to avoid posting on initial bootstrap
GO_BOOTSTRAP_POST_LATEST=false
GO_INCLUDE_BUSES=false
GO_DEBUG=false
# Optional filter: comma-separated list of line codes or corridor names (e.g. LW,LE,ST)
GO_LINES_ALLOWLIST=
GO_SSL_VERIFY=true
GO_CA_BUNDLE_PATH=

# ==============================================================================
# Job Alerts (Greenhouse, Lever, Workday)
# ==============================================================================
# [DEPRECATED] Legacy fallback for JOB_ALERTS_CHANNEL_ID
JOBS_CHANNEL_ID=0
JOB_ALERTS_CHANNEL_ID=0
JOBS_POLL_SECONDS=600
JOBS_BOOTSTRAP_POST=false
JOBS_REQUIRE_EARLY_CAREER=false

# Comma-separated organization tokens for job boards
# Example: GREENHOUSE_BOARDS=shopify,stripe,figma
GREENHOUSE_BOARDS=
# Example: LEVER_SITES=palantir,ramp
LEVER_SITES=

# Job search filtering
JOBS_LOCATION_ALLOWLIST=
JOBS_KEYWORDS_ALLOWLIST=
JOBS_KEYWORDS_DENYLIST=

# Workday job scrape targets (format: "Name|BaseSearchURL", comma-separated)
WORKDAY_SITES=
# Set to 0 in runtime env to inherit JOBS_POLL_SECONDS
WORKDAY_POLL_SECONDS=600
WORKDAY_TIMEOUT_SECONDS=12

# ==============================================================================
# Casino / Mini-games (Blackjack)
# ==============================================================================
BJ_STARTING_BANKROLL=1000
BJ_DEALER_HITS_SOFT_17=true
BJ_MAX_SPLITS=1
BJ_SESSION_TTL_MINUTES=20

# ==============================================================================
# Academic Tools (Course Notes, RateMyProfessors, Exams)
# ==============================================================================
# Comma-separated list of student note hubs in "Title|SiteURL" format
# Note: Course notes hosted on Notion or external platforms are third-party student content.
NOTES_SITES=

# University name for RateMyProfessors school search
RMP_UNIVERSITY=Toronto Metropolitan University

# Timezone for scheduled exam countdowns
EXAMS_TZ=America/Toronto

# ==============================================================================
# Database / Persistence
# ==============================================================================
# Canonical SQLite database file paths (do NOT commit SQLite database files to Git).
# Local development defaults to relative paths ('ic_stock.db', 'tmu_grades.db').
# Container / Docker Compose / Railway deployments override these to '/data/campus.db'
# and '/data/tmu_grades.db'; systemd overrides to '/opt/campus-bot/data/...'.
# Note: Legacy 'SQLITE_PATH' is a deprecated alias for 'DB_PATH' (scheduled for removal in v1.1.0).
DB_PATH=ic_stock.db
GRADES_DB_PATH=tmu_grades.db
