# ============================
# Modular Discord Bot (.env.example)
# v0.2.12
# ============================

# ----------------------------
# Core
# ----------------------------
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN
# Optional: for faster command propagation during development
GUILD_ID=0
# SQLite DB path
DB_PATH=icbot.db

# ----------------------------
# Channel IDs (set to 0 to disable)
# ----------------------------
# Jobs
JOB_ALERTS_CHANNEL_ID=0
# Some builds also accept JOBS_CHANNEL_ID as a fallback; set both if unsure
JOBS_CHANNEL_ID=0

# TTC alerts
TTC_ALERTS_CHANNEL_ID=0

# GO alerts
GO_ALERTS_CHANNEL_ID=0

# Market watch / stock channel
MARKET_WATCH_CHANNEL_ID=0
STOCK_CHANNEL_ID=0

# Daily market report
MARKET_DAILY_REPORT_CHANNEL_ID=0

# BTC address watch
BTC_WATCH_CHANNEL_ID=0

# Optional: TTC alternative channel naming (if your build uses it)
TTC_CHANNEL_ID=0

# ----------------------------
# Admin / Permissions
# ----------------------------
# Comma-separated role IDs that can use admin-only commands
ALLOWED_ROLE_IDS=
# Optional: restrict user commands to a single channel ID
USER_COMMAND_CHANNEL_ID=0

# ----------------------------
# Jobs: Polling + Sources
# ----------------------------
JOBS_POLL_SECONDS=600

# Greenhouse board tokens (comma-separated)
GREENHOUSE_BOARDS=
# Lever site slugs (comma-separated)
LEVER_SITES=

# Workday sites list.
# Format (repeatable, pipe-delimited): Label|BaseURL
# Example:
# WORKDAY_SITES=RBC|https://rbc.wd3.myworkdayjobs.com/en-US/RBC,BMO|https://bmo.wd3.myworkdayjobs.com/External
WORKDAY_SITES=

# Job filters (comma-separated)
# Location allowlist (recommended: include remote/hybrid if you want those)
JOBS_LOCATION_ALLOWLIST=toronto,ontario,canada,united states,usa,us,remote,hybrid

# Keywords allowlist (tech-focused). Keep short tokens out (e.g., "c") to avoid false positives.
JOBS_KEYWORDS_ALLOWLIST=software,software engineer,software developer,developer,backend,frontend,full stack,platform,infrastructure,systems,distributed,cloud,devops,sre,site reliability,embedded,firmware,fpga,asic,verification,kernel,security,cyber,data engineer,machine learning,ml,ai,quant,trading,c++,cpp,python,java,golang,go,rust,dotnet,.net,new grad,intern,internship,co-op,coop,student,entry level,junior

# Keywords denylist (business/non-tech + seniority blocklist if desired)
JOBS_KEYWORDS_DENYLIST=sales,marketing,brand,business development,account executive,account manager,customer support,customer experience,customer success,hr,talent,recruiter,staffing,sourcer,coordinator,product manager,product owner,program manager,project manager,tpm,scrum,agile,designer,ux,ui,graphic,finance,accounting,audit,operations,banking,advisor,claims,collections,payroll,legal,paralegal,assistant,administrator,admin,secretary,principal,staff,senior,lead,manager,director,head,vp,vice president,chief

# Bootstrap behavior: optionally post a small initial batch on boot
JOBS_BOOTSTRAP_POST=false
# Optional cap for bootstrap posting (if supported in your build)
JOBS_BOOTSTRAP_MAX_POSTS=10

# ----------------------------
# TTC Alerts
# ----------------------------
TTC_POLL_SECONDS=120
# Example mastodon instance/account (if your implementation uses it)
TTC_MASTODON_BASE=https://mstdn.ca
TTC_MASTODON_ACCT=ttcnotices
# major | all
TTC_ALERT_LEVEL=major
TTC_BOOTSTRAP_POST_LATEST=false
TTC_DEBUG=false

# ----------------------------
# GO Transit Alerts (Metrolinx Open Data API)
# ----------------------------
GO_ALERTS_ENABLED=false
GO_API_BASE=https://api.openmetrolinx.com/OpenDataAPI/api/V1
GO_API_KEY=

GO_POLL_SECONDS=180
# major | all
GO_ALERT_LEVEL=major
GO_BOOTSTRAP_POST_LATEST=false
GO_DEBUG=false

# Allowlist only the GO lines you care about.
# Accepts codes or names (case-insensitive). Examples:
# GO_LINES_ALLOWLIST=LW,LE,ST
# GO_LINES_ALLOWLIST=Lakeshore West,Lakeshore East,Stouffville
GO_LINES_ALLOWLIST=Lakeshore West,Lakeshore East,Stouffville

# Optional: exclude facility/accessibility advisories (if supported by your build)
GO_EXCLUDE_FACILITY_KEYWORDS=elevator,escalator,washroom,restroom,parking

# Optional TLS settings (only if needed)
GO_SSL_VERIFY=true
GO_CA_BUNDLE_PATH=

# ----------------------------
# Market Watch
# ----------------------------
MARKET_WATCH_ENABLED=false
MARKET_WATCH_POLL_SECONDS=60
MARKET_WATCH_VIX_LEVEL=20
MARKET_WATCH_INDEX_MOVE_PCT=2.5
MARKET_WATCH_STOCK_MOVE_PCT=10
MARKET_WATCH_COOLDOWN_MINUTES=30
# Comma-separated tickers (optional)
MARKET_WATCH_TICKERS=

# ----------------------------
# Daily Market Report
# ----------------------------
MARKET_DAILY_REPORT_ENABLED=false
MARKET_DAILY_REPORT_TZ=America/Toronto
# 24h time HH:MM (e.g., 16:30)
MARKET_DAILY_REPORT_TIME=16:30
MARKET_DAILY_REPORT_DEBUG=false

# ----------------------------
# BTC Address Watch (Optional)
# ----------------------------
BTC_WATCH_ENABLED=false
BTC_ESPLORA_BASE=https://blockstream.info/api
BTC_WATCH_ADDRESSES=
BTC_WATCH_POLL_SECONDS=180
BTC_WATCH_DEBUG=false

# ----------------------------
# LLM Mention Assistant (Gemini)
# ----------------------------
LLM_ENABLED=false

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Guardrails
LLM_COOLDOWN_SECONDS=3
LLM_MAX_MESSAGES=25
LLM_MAX_CHARS=12000
LLM_MAX_OUTPUT_CHARS=800
LLM_DEBUG=false

# Optional: customize assistant behavior and tone
LLM_SYSTEM_PROMPT=You are a helpful Discord assistant. Be concise and clear. Use recent chat context only when relevant. Do not use @everyone/@here. Follow explicit user constraints.
