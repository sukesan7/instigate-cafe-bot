# ==============================================================================
# Instigate Cafe Bot — Environment Configuration
# ==============================================================================
# Notes:
# - 
# 
# ==============================================================================
# Discord — core
# ==============================================================================
DISCORD_TOKEN=
GUILD_ID=

# ==============================================================================
# Embed Settings
# ==============================================================================
EMBED_LOGO_URL=
# You can use: #A64DFF or 0xA64DFF
EMBED_ACCENT_COLOR=#A64DFF
EMBED_FOOTER_TEXT=Instigate Cafe

# ==============================================================================
# Discord — Roles / Permissions
# ==============================================================================
# Used by /ic admin-only commands
ADMIN_ROLE_ID=

# Where “general bot commands” are allowed (comma list of channel IDs)
ALLOWED_CHANNEL_IDS=

# ==============================================================================
# LLM Mention Assistant (Gemini)
# ==============================================================================
LLM_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_RESUME_MODEL="gemini-2.5-pro"
GEMINI_RESUME_PROMPT="You are a Senior Software Engineer at a FAANG company hiring for a New Grad or Junior role. Review the provided resume deeply and provide: 1. Overall Rating (x/10) 2. Strongest Pros 3. Biggest Cons 4. Market Competitiveness 5. Actionable Feedback to improve it. Be ruthless but constructive."
LLM_COOLDOWN_SECONDS=3
LLM_MAX_MESSAGES=25
LLM_MAX_CHARS=8000
LLM_DEBUG=false

# ==============================================================================
# Stock Market / BTC (Satoshi) Watcher
# ==============================================================================
# Primary “stocks/markets” output channel (also used as fallback for market watch)
STOCK_CHANNEL_ID=

# Market watch (volatility, VIX, Fear & Greed, etc.)
MARKET_WATCH_ENABLED=true
MARKET_WATCH_CHANNEL_ID=
MARKET_WATCH_POLL_SECONDS=60
MARKET_WATCH_VIX_LEVEL=30
MARKET_WATCH_INDEX_MOVE_PCT=2.5
MARKET_WATCH_STOCK_MOVE_PCT=10
MARKET_WATCH_COOLDOWN_MINUTES=30

# Daily market report (scheduled recap)
MARKET_DAILY_REPORT_ENABLED=true
MARKET_DAILY_REPORT_CHANNEL_ID=
MARKET_DAILY_REPORT_TIME=16:30
MARKET_DAILY_REPORT_TZ=America/Toronto
MARKET_DAILY_REPORT_TOP_N=8

# BTC “whale / institution” watch (address-based)
BTC_WATCH_ENABLED=true
BTC_WATCH_CHANNEL_ID=
BTC_WATCH_POLL_SECONDS=600
BTC_WATCH_COOLDOWN_MINUTES=30
BTC_WATCH_LABEL=BTC Whale / Institution Watch
# Suggested starter set:
BTC_WATCH_ADDRESSES=
# Optional override (default is blockstream.info/api)
BTC_ESPLORA_BASE_URL=https://blockstream.info/api

# ==============================================================================
# Stock Feature / Alpha Vantage (optional)
# ==============================================================================
ALPHAVANTAGE_API_KEY=

# ==============================================================================
# OddsAPI
# ==============================================================================
ODDS_API_KEY=

# ==============================================================================
# TTC / Transit Alerts
# ==============================================================================
TTC_CHANNEL_ID=
TTC_ALERTS_CHANNEL_ID=
TTC_ALERT_LEVEL=major
TTC_BOOTSTRAP_POST_LATEST=false
TTC_MASTODON_BASE=
TTC_MASTODON_ACCT=
TTC_INCLUDE_REPLIES=true
TTC_INCLUDE_REBLOGS=false
TTC_DEBUG=false

# ==============================================================================
# GO / Transit Alerts
# ==============================================================================
GO_API_BASE=https://api.openmetrolinx.com/OpenDataAPI/api/V1
GO_API_KEY=
GO_ALERTS_CHANNEL_ID=
GO_POLL_SECONDS=180
GO_ALERT_LEVEL=major         # major | all
GO_BOOTSTRAP_POST_LATEST=false
GO_INCLUDE_BUSES=false
GO_DEBUG=false
GO_LINES_ALLOWLIST=
GO_SSL_VERIFY=true
GO_CA_BUNDLE_PATH=

# ==============================================================================
# Jobs Alerts (Greenhouse / Lever)
# ==============================================================================
JOBS_CHANNEL_ID=
JOB_ALERTS_CHANNEL_ID=
JOBS_POLL_SECONDS=600
JOBS_BOOTSTRAP_POST=false

# Boards and sites
GREENHOUSE_BOARDS=
LEVER_SITES=

# Job filters
JOBS_LOCATION_ALLOWLIST=
JOBS_KEYWORDS_ALLOWLIST=
JOBS_KEYWORDS_DENYLIST=

# ==============================================================================
# Workday Jobs Alerts
# ==============================================================================
# Format is "Name|BaseSearchURL". You have exactly 30 entries here.
WORKDAY_SITES=

# If WORKDAY_POLL_SECONDS=0, Workday inherits JOBS_POLL_SECONDS
WORKDAY_POLL_SECONDS=600
WORKDAY_TIMEOUT_SECONDS=12

# ==============================================================================
# Blackjack (if you use /ic blackjack)
# ==============================================================================
BJ_STARTING_BANKROLL=100
BJ_DEALER_HITS_SOFT_17=true
BJ_MAX_SPLITS=1
BJ_SESSION_TTL_MINUTES=20

# ==============================================================================
# Database / Persistence
# ==============================================================================
DB_PATH=ic_stock.db
EXAMS_TZ=America/Toronto

# ==============================================================================
# Admin / Dev
# ==============================================================================
FORCE_GUILD_RESYNC=false
